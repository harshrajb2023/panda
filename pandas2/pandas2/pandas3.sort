bios=pd.read_csv('bios.csv')
bios ['born_date'] = pd. to_datetime(bios ['born_date'])
bios ['month_born'] = bios['born_date'].dt.month
bios ['year_born'] = bios['born_date'].dt.year
bios['weight_kg1']=bios['weight_kg'].shift(2)
bios['avg']=bios['weight_kg']/bios['height_cm']
bios['rank']=bios['avg'].rank()
bios['rank'].sort_values()
bios.sort_values(['rank'])
bios.sort_values(['rank'], ascending=False)
bios.sort_values(['rank'], ascending=False).sample(10)
bios.sort_values(['rank']).sample(10)[['year_born','rank']]
