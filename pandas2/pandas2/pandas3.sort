import pandas as pd
import requests
from io import StringIO
# URL of the CSV file
url = "https://raw.githubusercontent.com/KeithGalli/complete-pandas-tutorial/master/data/noc_regions.csv"
# Fetch data while disabling SSL verification (not recommended for sensitive data)
response = requests.get(url, verify=False)
# Convert to pandas DataFrame
df = pd.read_csv(StringIO(response.text))
# Save it locally
df.to_csv("noc_regions.csv", index=False)
df
#
merge_with_different_columns = pd.merge(data, df, left_on='born_country', right_on='NOC', how='left')
merged_data = pd.merge(data, df, left_on='born_country', right_on='NOC', how='left', suffixes=('_left', '_right'))
merge_with_different_columns[merge_with_different_columns['NOC_x'] != merge_with_different_columns['born_country']][['name', 'NOC_x', 'born_country']]
usa = merge_with_different_columns [merge_with_different_columns ['born_country']=='USA']. copy ()
gbr = merge_with_different_columns [merge_with_different_columns ['born_country']=='GBR']. copy ()
new_df=pd.concat([usa,gbr])
import numpy as np
new_df.loc[[54,960],'height_cm']=np.nan
df_filled = new_df.fillna(new_df['weight_kg'].interpolate())
new_df['weight_kg'].interpolate()
